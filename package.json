  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "benchmark": "bun run src/evals/nsm-comparative-benchmark.ts",
    "benchmark:sim": "bun run src/evals/nsm-comparative-benchmark.ts",
    "benchmark:live": "bun run src/evals/live-competitors.ts",
    "benchmark:niah": "bun run src/evals/needle-haystack-benchmark.ts",
    "benchmark:swarm": "bun run src/evals/swarm-acceleration-benchmark.ts",
    "benchmark:focus": "bun run src/evals/focus-hysteresis-benchmark.ts",
    "benchmark:security": "bun run src/evals/authority-security-benchmark.ts",
    "benchmark:standard": "bun run src/evals/standard-benchmarks.ts",
    "benchmark:locomo": "bun run src/evals/locomo-canonical.ts",
    "benchmark:all": "bun run src/evals/run-all-benchmarks.ts"
  },
  "keywords": [
