{
  "name": "@skillvault/nsm",
  "version": "3.1.0",
  "description": "nsm: a local memory for AI agents. SQLite FTS5 hybrid retrieval with optional on-device embedding and reranking, short-term memories that decay into long-term, pinned rules and absence flags. No API calls.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "cli": "bun run bin/nsm.ts"
  },
  "keywords": [
    "memory",
    "agent-memory",
    "mcp",
    "sqlite-fts5",
    "bm25",
    "hybrid-retrieval",
    "reranker",
    "local-first"
  ],
  "author": "Anthony Lee",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "3.5.2"
  },
  "bin": {
    "nsm": "bin/nsm.ts"
  },
  "files": [
    "bin",
    "src",
    "install.sh",
    "README.md",
    "NSM-SPEC.md",
    "LICENSE"
  ]
}
